# Supabase (PostgREST). Tables are created by supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Shared secret checked by Postgres RLS (must match the value baked into ho_ok() in schema.sql)
HANDOVER_DB_KEY=long-random-string
# Signs seller session cookies
SESSION_SECRET=another-long-random-string

# PayPal sandbox (optional). Leave empty for demo payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI (optional). Without any of these, every AI feature uses its rules fallback.
# Free option: Google AI Studio key (no card) via Gemini's OpenAI-compatible endpoint
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# Alternative: Vercel AI Gateway (OIDC on Vercel with AI_GATEWAY_ENABLED=1, or a key)
# AI_GATEWAY_ENABLED=1
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=spacexai/grok-4.1-fast-non-reasoning

# Protects /api/cron/sweep (Vercel Cron sends it automatically)
CRON_SECRET=
