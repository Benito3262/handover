# Supabase (PostgREST). Tables are created by supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Shared secret checked by Postgres RLS (must match the value baked into ho_ok() in schema.sql)
HANDOVER_DB_KEY=long-random-string
# Signs seller session cookies
SESSION_SECRET=another-long-random-string

# PayPal sandbox (optional). Leave empty for demo payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI: on Vercel, AI Gateway authenticates with OIDC automatically.
# Locally, set AI_GATEWAY_API_KEY or run `vercel env pull`. Without either, rules fallback is used.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=spacexai/grok-4.1-fast-non-reasoning

# Protects /api/cron/sweep (Vercel Cron sends it automatically)
CRON_SECRET=
